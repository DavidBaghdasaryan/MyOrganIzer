<UserControl x:Class="MyOrganizer.Wpf.Controls.OdontogramView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="OdontogramToothButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="4"
                                Padding="1,1,1,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="Chrome" Property="Background" Value="#DBEAFE"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="OdontogramToothTemplate">
            <Button Style="{StaticResource OdontogramToothButton}"
                    Command="{Binding DataContext.SelectToothCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding Fdi}">
                <StackPanel Width="38">
                    <Grid Width="32" Height="44" HorizontalAlignment="Center">
                        <Image Source="{Binding Preview}" Stretch="Uniform"
                               Visibility="{Binding ShowNaturalTooth, Converter={StaticResource BoolToVis}}"/>
                        <Canvas Visibility="{Binding ShowMissing, Converter={StaticResource BoolToVis}}">
                            <Ellipse Canvas.Left="6" Canvas.Top="8" Width="20" Height="28"
                                     Stroke="#B0B8C0" StrokeThickness="1.2" StrokeDashArray="2 2"
                                     Fill="#F3F4F6"/>
                            <Path Data="M 9,13 L 23,31 M 23,13 L 9,31"
                                  Stroke="#9CA3AF" StrokeThickness="1.5" StrokeStartLineCap="Round"/>
                        </Canvas>
                        <Canvas Visibility="{Binding ShowImplant, Converter={StaticResource BoolToVis}}">
                            <Ellipse Canvas.Left="8" Canvas.Top="3" Width="16" Height="9"
                                     Fill="#EEF1F4" Stroke="#9AA3AD" StrokeThickness="0.9"/>
                            <Rectangle Canvas.Left="12" Canvas.Top="11" Width="8" Height="3.5"
                                       Fill="#8B939E"/>
                            <Path Fill="#6B7280" Stroke="#4B5563" StrokeThickness="0.7"
                                  Data="M 11,14.5 L 21,14.5 L 20.2,17 L 11.8,17 L 21,19.5 L 11,19.5 L 20,22 L 12,22 L 19.2,25 L 12.8,25 L 18.4,29 L 13.6,29 L 17.4,34 L 14.6,34 L 16,39 Z"/>
                        </Canvas>
                        <Canvas IsHitTestVisible="False"
                                Visibility="{Binding ShowEndodontic, Converter={StaticResource BoolToVis}}">
                            <Path Stroke="#C62828" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="{Binding IsUpper, Converter={StaticResource BoolToVis}}"
                                  Data="M 16,34 C 17.2,24 14.8,14 16,6"/>
                            <Path Stroke="#C62828" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="{Binding IsLower, Converter={StaticResource BoolToVis}}"
                                  Data="M 16,10 C 14.8,20 17.2,30 16,38"/>
                        </Canvas>
                        <Canvas IsHitTestVisible="False"
                                Visibility="{Binding ShowFilling, Converter={StaticResource BoolToVis}}">
                            <Ellipse Width="11" Height="7" Fill="#C5CBD1" Stroke="#9AA3AD" StrokeThickness="0.8"
                                     Canvas.Left="10.5" Canvas.Top="30"
                                     Visibility="{Binding IsUpper, Converter={StaticResource BoolToVis}}"/>
                            <Ellipse Width="11" Height="7" Fill="#C5CBD1" Stroke="#9AA3AD" StrokeThickness="0.8"
                                     Canvas.Left="10.5" Canvas.Top="7"
                                     Visibility="{Binding IsLower, Converter={StaticResource BoolToVis}}"/>
                        </Canvas>
                    </Grid>
                    <TextBlock Text="{Binding Fdi}" FontSize="10"
                               HorizontalAlignment="Center" Margin="0,1,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#163A5F"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#1D4ED8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Button>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="OdontogramRowPanel">
            <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
    </UserControl.Resources>
    <StackPanel>
        <DockPanel LastChildFill="False" Margin="0,0,0,8">
            <TextBlock Text="Patient" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Width="168" VerticalAlignment="Center"
                      ItemsSource="{Binding Patients}"
                      SelectedItem="{Binding CurrentPatient, Mode=TwoWay}"
                      DisplayMemberPath="Name"/>
        </DockPanel>
        <ItemsControl ItemsSource="{Binding ChartRows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="{Binding Jaw}" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl ItemsSource="{Binding Right}"
                                          ItemTemplate="{StaticResource OdontogramToothTemplate}"
                                          ItemsPanel="{StaticResource OdontogramRowPanel}"/>
                            <Border Width="1" Height="50" Background="#D1D5DB" Margin="6,0,7,8" VerticalAlignment="Top"/>
                            <ItemsControl ItemsSource="{Binding Left}"
                                          ItemTemplate="{StaticResource OdontogramToothTemplate}"
                                          ItemsPanel="{StaticResource OdontogramRowPanel}"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>

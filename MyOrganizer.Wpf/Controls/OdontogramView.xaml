<UserControl x:Class="MyOrganizer.Wpf.Controls.OdontogramView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MyOrganizer.Wpf.Controls">
    <UserControl.Resources>
        <Style x:Key="OdontogramToothButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="4"
                                Padding="1,1,1,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="Chrome" Property="Background" Value="#DBEAFE"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="OdontogramToothTemplate">
            <Button Style="{StaticResource OdontogramToothButton}"
                    Command="{Binding DataContext.SelectToothCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding Fdi}">
                <StackPanel Width="43">
                    <Grid Width="32" Height="44" HorizontalAlignment="Center">
                        <Grid.LayoutTransform>
                            <ScaleTransform ScaleX="1.13" ScaleY="1.13"/>
                        </Grid.LayoutTransform>
                        <Image Source="{Binding Preview}" Stretch="Uniform"
                               Visibility="{Binding ShowNaturalTooth, Converter={StaticResource BoolToVis}}"/>
                        <Canvas Visibility="{Binding ShowMissing, Converter={StaticResource BoolToVis}}">
                            <Ellipse Canvas.Left="6" Canvas.Top="8" Width="20" Height="28"
                                     Stroke="#B0B8C0" StrokeThickness="1.2" StrokeDashArray="2 2"
                                     Fill="#F3F4F6"/>
                            <Path Data="M 9,13 L 23,31 M 23,13 L 9,31"
                                  Stroke="#9CA3AF" StrokeThickness="1.5" StrokeStartLineCap="Round"/>
                        </Canvas>
                        <local:ImplantOdontogramVisual
                            FdiNumber="{Binding Fdi}"
                            Visibility="{Binding ShowImplant, Converter={StaticResource BoolToVis}}"/>
                        <local:EndodonticOdontogramVisual
                            FdiNumber="{Binding Fdi}"
                            CanalIds="{Binding TreatedCanalIds}"
                            Visibility="{Binding ShowEndodontic, Converter={StaticResource BoolToVis}}"/>
                        <Canvas IsHitTestVisible="False"
                                Visibility="{Binding ShowFilling, Converter={StaticResource BoolToVis}}">
                            <Ellipse Width="11" Height="7" Fill="#C5CBD1" Stroke="#9AA3AD" StrokeThickness="0.8"
                                     Canvas.Left="10.5" Canvas.Top="30"
                                     Visibility="{Binding IsUpper, Converter={StaticResource BoolToVis}}"/>
                            <Ellipse Width="11" Height="7" Fill="#C5CBD1" Stroke="#9AA3AD" StrokeThickness="0.8"
                                     Canvas.Left="10.5" Canvas.Top="7"
                                     Visibility="{Binding IsLower, Converter={StaticResource BoolToVis}}"/>
                        </Canvas>
                    </Grid>
                    <TextBlock Text="{Binding Fdi}" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#163A5F"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#1D4ED8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Button>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="OdontogramRowPanel">
            <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
    </UserControl.Resources>
    <ItemsControl ItemsSource="{Binding ChartRows}"
                  HorizontalAlignment="Center">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,6" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Jaw}" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding Right}"
                                          ItemTemplate="{StaticResource OdontogramToothTemplate}"
                                          ItemsPanel="{StaticResource OdontogramRowPanel}"/>
                            <Border Width="1" Height="56" Background="#D1D5DB" Margin="6,0,7,8" VerticalAlignment="Top"/>
                            <ItemsControl ItemsSource="{Binding Left}"
                                          ItemTemplate="{StaticResource OdontogramToothTemplate}"
                                          ItemsPanel="{StaticResource OdontogramRowPanel}"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
</UserControl>

<UserControl x:Class="MyOrganizer.Wpf.Controls.AppSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource Brush.SidebarBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="20,22,20,18">
                <TextBlock Text="MO"
                           FontFamily="Segoe UI"
                           FontWeight="Bold"
                           FontSize="18"
                           Foreground="{StaticResource Brush.SidebarAccent}"/>
                <TextBlock Text="{Binding Brand}"
                           Style="{StaticResource Navigation}"
                           Foreground="{StaticResource Brush.SidebarText}"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding NavItems}" Margin="10,0,10,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton GroupName="ShellNav"
                                     Style="{StaticResource NavItem}"
                                     IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                     Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     CommandParameter="{Binding Section}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="{Binding Label}"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>

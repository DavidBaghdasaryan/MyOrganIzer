<UserControl x:Class="MyOrganizer.Wpf.Controls.ToothControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="52" MinHeight="120"
             Cursor="Hand"
             Focusable="True"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             ClipToBounds="False">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ToothNumberBrush" Color="#163A5F"/>
    </UserControl.Resources>
    <Grid ClipToBounds="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Geometry is drawn in a padded canvas so stroke/selection never sit on the clip edge. -->
        <Viewbox Grid.Row="0" Stretch="Uniform" Margin="2,2,2,0" ClipToBounds="False">
            <Canvas x:Name="PartCanvas" Width="112" Height="112" ClipToBounds="False"/>
        </Viewbox>

        <TextBlock x:Name="PartNumber" Grid.Row="1"
                   Text="{Binding ToothNumber, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   HorizontalAlignment="Center"
                   Margin="0,2,0,0"
                   FontFamily="Segoe UI"
                   FontWeight="SemiBold"
                   FontSize="13"
                   Foreground="{StaticResource ToothNumberBrush}"/>

        <ItemsControl x:Name="PartBadges"
                      Grid.Row="0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Margin="0,0,0,0"
                      IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="5" Padding="4,1" Margin="1"
                            Background="{Binding Brush}" Opacity="0.95">
                        <TextBlock Text="{Binding Code}"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   FontSize="9"/>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>

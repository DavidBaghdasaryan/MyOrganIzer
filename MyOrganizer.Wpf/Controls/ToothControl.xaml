<UserControl x:Class="MyOrganizer.Wpf.Controls.ToothControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="40" MinHeight="148"
             Cursor="Hand"
             Focusable="True"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             ClipToBounds="False">
    <Grid ClipToBounds="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Viewbox Grid.Row="0" Stretch="Uniform" Margin="0,2" Height="130"
                 HorizontalAlignment="Center" ClipToBounds="False"
                 SnapsToDevicePixels="True">
            <Canvas x:Name="PartCanvas" Width="88" Height="136" ClipToBounds="False"/>
        </Viewbox>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center">
            <TextBlock x:Name="PartNumber"
                       Text="{Binding ToothNumber, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       HorizontalAlignment="Center"
                       FontFamily="Segoe UI"
                       FontWeight="SemiBold"
                       FontSize="11"
                       Foreground="#163A5F"/>
            <ItemsControl x:Name="PartBadges"
                          HorizontalAlignment="Center"
                          Visibility="Collapsed"
                          IsHitTestVisible="False"/>
        </StackPanel>
    </Grid>
</UserControl>

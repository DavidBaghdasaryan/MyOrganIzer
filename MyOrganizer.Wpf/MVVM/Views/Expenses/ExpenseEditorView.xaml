<UserControl x:Class="MyOrganizer.Wpf.MVVM.Views.Expenses.ExpenseEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MyOrganizer.Wpf.Localization">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding ShowContent, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Command="{Binding BackCommand}" Style="{StaticResource SecondaryButton}"
                            Height="28" Padding="10,2" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding BackLabel}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="{loc:Loc Cancel}" Command="{Binding CancelCommand}"
                                Style="{StaticResource SecondaryButton}" Height="36" MinWidth="100" Margin="0,0,8,0"/>
                        <Button Content="{loc:Loc Save}" Command="{Binding SaveCommand}"
                                Style="{StaticResource ModernButton}" Height="36" MinWidth="108"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding Error}" Style="{StaticResource FieldError}" Margin="0,0,0,12"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Supplier}" Style="{StaticResource Caption}"/>
                            <ComboBox Style="{StaticResource ModernComboBox}" Height="36" Margin="0,4,0,0"
                                      ItemsSource="{Binding SupplierChoices}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedSupplier}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:Loc TransactionDate}" Style="{StaticResource Caption}"/>
                            <DatePicker Style="{StaticResource ModernDatePicker}" Margin="0,4,0,0"
                                        SelectedDate="{Binding Date}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="{loc:Loc Reference}" Style="{StaticResource Caption}"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Height="36" Margin="0,4,0,0"
                                     Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="{loc:Loc ExpenseLines}" Style="{StaticResource SectionTitle}"/>
                            <Button Content="{loc:Loc AddItem}" Command="{Binding AddLineCommand}"
                                    Style="{StaticResource SecondaryButton}" Height="32" MinWidth="120"
                                    HorizontalAlignment="Right"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1"
                                            Padding="0,0,0,12" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="0.9*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="1.8*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="0.55*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="0.9*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc Kind}" Style="{StaticResource Caption}"/>
                                                    <ComboBox Style="{StaticResource ModernComboBox}" Height="36" Margin="0,4,0,0"
                                                              ItemsSource="{Binding DataContext.KindOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              DisplayMemberPath="Label" SelectedValuePath="Kind"
                                                              SelectedValue="{Binding Kind}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{loc:Loc ProductOrService}" Style="{StaticResource Caption}"/>
                                                    <ComboBox Style="{StaticResource ModernComboBox}" Height="36" Margin="0,4,0,0"
                                                              ItemsSource="{Binding Choices}" DisplayMemberPath="Name"
                                                              SelectedItem="{Binding SelectedChoice}"
                                                              Visibility="{Binding ShowCatalogPicker, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBox Style="{StaticResource ModernTextBox}" Height="36" Margin="0,4,0,0"
                                                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                             Visibility="{Binding ShowManualDescription, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="{loc:Loc Quantity}" Style="{StaticResource Caption}"/>
                                                    <TextBox Style="{StaticResource ModernTextBox}" Height="36" Margin="0,4,0,0"
                                                             Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="6">
                                                    <TextBlock Text="{loc:Loc Unit}" Style="{StaticResource Caption}"/>
                                                    <ComboBox Style="{StaticResource ModernComboBox}" Height="36" Margin="0,4,0,0"
                                                              ItemsSource="{Binding DataContext.Units, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              DisplayMemberPath="Name" SelectedItem="{Binding Unit}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="8">
                                                    <TextBlock Text="{loc:Loc UnitPrice}" Style="{StaticResource Caption}"/>
                                                    <TextBox Style="{StaticResource ModernTextBox}" Height="36" Margin="0,4,0,0"
                                                             Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="10">
                                                    <TextBlock Text="{loc:Loc Total}" Style="{StaticResource Caption}"/>
                                                    <TextBlock Text="{Binding LineTotalDisplay}" Style="{StaticResource SectionTitle}" Margin="0,10,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="12" Style="{StaticResource SecondaryButton}"
                                                        Content="{loc:Loc Delete}" Height="32" Padding="12,4" Margin="0,22,0,0"
                                                        Command="{Binding RemoveCommand}" ToolTip="{loc:Loc RemoveLine}"/>
                                            </Grid>
                                            <Button Content="{loc:Loc LinkToPatient}" Command="{Binding ToggleCaseLinkCommand}"
                                                    Style="{StaticResource SecondaryButton}" Height="28" Margin="0,8,0,0"
                                                    HorizontalAlignment="Left" Padding="10,2"/>
                                            <Grid Margin="0,8,0,0" Visibility="{Binding ShowCaseLink, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.6*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="1.6*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="0.7*"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Style="{StaticResource ModernComboBox}" Height="36"
                                                          ItemsSource="{Binding DataContext.Clients, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          DisplayMemberPath="Name" SelectedItem="{Binding SelectedClient}"/>
                                                <ComboBox Grid.Column="2" Style="{StaticResource ModernComboBox}" Height="36"
                                                          ItemsSource="{Binding DataContext.Procedures, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          DisplayMemberPath="Name" SelectedItem="{Binding SelectedProcedure}"/>
                                                <TextBox Grid.Column="4" Style="{StaticResource ModernTextBox}" Height="36"
                                                         Text="{Binding ToothFdi, UpdateSourceTrigger=PropertyChanged}"
                                                         Tag="{loc:Loc Tooth}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,8,0,0">
                            <TextBox Style="{StaticResource ModernTextBox}" Height="72" Margin="0,0,180,0"
                                     Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="{loc:Loc Notes}" TextWrapping="Wrap" AcceptsReturn="True"/>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <TextBlock Text="{loc:Loc Total}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding TotalDisplay}" Style="{StaticResource PageTitle}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Background="#99FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="…" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="MyOrganizer.Wpf.MVVM.Views.Procedures.ProceduresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MyOrganizer.Wpf.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{loc:Loc Procedures}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{loc:Loc ProceduresSubtitle}" Style="{StaticResource Body}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="{loc:Loc AddProcedure}"
                    Command="{Binding AddCommand}"
                    Style="{StaticResource ModernButton}"
                    MinWidth="148" Height="36"
                    VerticalAlignment="Center"
                    ToolTip="{loc:Loc Add}"/>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Height="36"
                         Style="{StaticResource ModernTextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{loc:Loc SearchProcedures}"
                         VerticalContentAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="{loc:Loc Clear}"
                        Command="{Binding ClearSearchCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Height="36"
                        Padding="12,6"
                        Margin="12,0,0,0"
                        Visibility="{Binding HasActiveFilter, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid x:Name="ProceduresGrid"
                          Style="{StaticResource ModernDataGrid}"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedRow}"
                          Visibility="{Binding ShowGrid, Converter={StaticResource BoolToVis}}"
                          MouseDoubleClick="ProceduresGrid_MouseDoubleClick">
                    <DataGrid.InputBindings>
                        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
                        <KeyBinding Key="Enter" Command="{Binding EditCommand}"/>
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc Name}" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="{loc:Loc Tier1}" Binding="{Binding Tier1Display}" Width="0.85*"/>
                        <DataGridTextColumn Header="{loc:Loc Tier2}" Binding="{Binding Tier2Display}" Width="0.85*"/>
                        <DataGridTextColumn Header="{loc:Loc Tier3}" Binding="{Binding Tier3Display}" Width="0.85*"/>
                        <DataGridTemplateColumn Width="56" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource IconButton}"
                                            Content="&#xE712;"
                                            Width="32" Height="32"
                                            HorizontalAlignment="Right"
                                            ToolTip="{loc:Loc More}"
                                            Click="RowMenu_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding ShowEmptyDatabase, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:Loc NoProceduresYet}" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc AddFirstProcedure}" Style="{StaticResource Body}" Margin="0,8,0,16" HorizontalAlignment="Center"/>
                    <Button Content="{loc:Loc AddProcedure}" Command="{Binding AddCommand}"
                            Style="{StaticResource ModernButton}" HorizontalAlignment="Center" MinWidth="148" Height="36"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding ShowEmptyFilter, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:Loc NoProceduresFound}" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc TryChangingFilters}" Style="{StaticResource Body}" Margin="0,8,0,16" HorizontalAlignment="Center"/>
                    <Button Content="{loc:Loc Clear}" Command="{Binding ClearSearchCommand}"
                            Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Height="36" Padding="16,6"/>
                </StackPanel>

                <Border Background="#99FFFFFF"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="…" Style="{StaticResource SectionTitle}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="MyOrganizer.Wpf.MVVM.Views.Clients.ClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MyOrganizer.Wpf.Localization"
             x:Name="Root">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{loc:Loc Clients}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{loc:Loc ClientsSubtitle}" Style="{StaticResource Body}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="{loc:Loc AddClient}"
                    Command="{Binding AddCommand}"
                    Style="{StaticResource ModernButton}"
                    MinWidth="132" Height="36"
                    VerticalAlignment="Center"
                    ToolTip="{loc:Loc Add}"/>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox MinWidth="140" Height="36"
                              Style="{StaticResource ModernComboBox}"
                              ItemsSource="{Binding SearchFields}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding SearchField}"
                              VerticalAlignment="Center"
                              ToolTip="{loc:Loc SearchBy}"/>

                    <TextBox Grid.Column="1" Height="36" Margin="8,0,0,0"
                             Style="{StaticResource ModernTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{loc:Loc SearchPlaceholder}"
                             VerticalContentAlignment="Center"/>

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <ToggleButton Content="{loc:Loc TodayAppointments}"
                                      Style="{StaticResource FilterChip}"
                                      IsChecked="{Binding TodayOnly}"
                                      Margin="0,0,8,0"
                                      ToolTip="{loc:Loc Reminders}"/>
                        <Button Content="{loc:Loc Clear}"
                                Command="{Binding ClearFiltersCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Height="36"
                                Padding="12,6"
                                Visibility="{Binding HasActiveFilter, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>

                <WrapPanel Margin="0,12,0,0">
                    <CheckBox Content="{loc:Loc FilterByMonth}"
                              IsChecked="{Binding FilterByMonth}"
                              VerticalAlignment="Center"
                              Margin="0,0,12,8"/>
                    <DatePicker Style="{StaticResource ModernDatePicker}"
                                SelectedDate="{Binding Month}"
                                Width="148"
                                Margin="0,0,16,8"
                                ToolTip="{loc:Loc DayOfRegistration}"/>
                    <Button Content="{loc:Loc MonthIncome}"
                            Command="{Binding MonthIncomeCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Height="32"
                            Margin="0,0,8,8"
                            Padding="12,4"
                            ToolTip="{loc:Loc MonthIncome}"/>
                    <Button Content="{loc:Loc MonthDebt}"
                            Command="{Binding MonthDebtCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Height="32"
                            Margin="0,0,12,8"
                            Padding="12,4"
                            ToolTip="{loc:Loc MonthDebt}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc TotalAmount}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding TotalAmount}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid x:Name="ClientsGrid"
                          Style="{StaticResource ModernDataGrid}"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedRow}"
                          Visibility="{Binding ShowGrid, Converter={StaticResource BoolToVis}}"
                          MouseDoubleClick="ClientsGrid_MouseDoubleClick">
                    <DataGrid.InputBindings>
                        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
                        <KeyBinding Key="Enter" Command="{Binding OpenCommand}"/>
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{loc:Loc FullName}" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource LinkButton}"
                                            Content="{Binding FullName}"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{loc:Loc OpenPatient}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{loc:Loc Phone}" Binding="{Binding Phone}" Width="*"/>
                        <DataGridTextColumn Header="{loc:Loc DayOfRegistration}"
                                            Binding="{Binding DateJoin, StringFormat=\{0:yyyy-MM-dd HH:mm\}}"
                                            Width="*"/>
                        <DataGridTextColumn Header="{loc:Loc Payment}" Binding="{Binding Price, StringFormat=0.##}" Width="0.7*"/>
                        <DataGridTextColumn Header="{loc:Loc Remains}" Binding="{Binding Debet, StringFormat=0.##}" Width="0.7*"/>
                        <DataGridTextColumn Header="{loc:Loc DoubleVisit}"
                                            Binding="{Binding Reminder, StringFormat=\{0:yyyy-MM-dd HH:mm\}}"
                                            Width="*"/>
                        <DataGridTemplateColumn Width="148" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Content="{loc:Loc Open}"
                                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Height="28"
                                                Padding="12,4"
                                                Margin="0,0,4,0"
                                                ToolTip="{loc:Loc OpenPatient}"/>
                                        <Button Style="{StaticResource IconButton}"
                                                Content="&#xE712;"
                                                Width="32" Height="32"
                                                ToolTip="{loc:Loc More}"
                                                Click="RowMenu_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding ShowEmptyDatabase, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:Loc NoClientsYet}" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc AddFirstClient}" Style="{StaticResource Body}" Margin="0,8,0,16" HorizontalAlignment="Center"/>
                    <Button Content="{loc:Loc AddClient}" Command="{Binding AddCommand}"
                            Style="{StaticResource ModernButton}" HorizontalAlignment="Center" MinWidth="148" Height="36"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding ShowEmptyFilter, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:Loc NoClientsFound}" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc TryChangingFilters}" Style="{StaticResource Body}" Margin="0,8,0,16" HorizontalAlignment="Center"/>
                    <Button Content="{loc:Loc Clear}" Command="{Binding ClearFiltersCommand}"
                            Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Height="36" Padding="16,6"/>
                </StackPanel>

                <Border Background="#99FFFFFF"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="…" Style="{StaticResource SectionTitle}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>

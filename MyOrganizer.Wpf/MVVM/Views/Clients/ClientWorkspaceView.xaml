<UserControl x:Class="MyOrganizer.Wpf.MVVM.Views.Clients.ClientWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MyOrganizer.Wpf.Localization"
             xmlns:vm="clr-namespace:MyOrganizer.Wpf.MVVM.ViewModels"
             PreviewKeyDown="Workspace_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="CompactWorkspaceTab" TargetType="RadioButton" BasedOn="{StaticResource WorkspaceTab}">
            <Setter Property="Padding" Value="2,2"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel>
                            <ContentPresenter HorizontalAlignment="Left" Margin="{TemplateBinding Padding}"/>
                            <Border x:Name="Line" Height="2" Background="Transparent" Margin="0,4,0,0" CornerRadius="1"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Primary}"/>
                                <Setter TargetName="Line" Property="Background" Value="{StaticResource Brush.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Command="{Binding BackCommand}"
                    Style="{StaticResource SecondaryButton}"
                    VerticalAlignment="Center"
                    Height="28"
                    Padding="10,2"
                    Margin="0,0,12,0"
                    ToolTip="{loc:Loc Clients}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding BackLabel}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0"
                        Visibility="{Binding ShowContent, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Title}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.TextPrimary}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Style="{StaticResource Caption}" Margin="0,1,0,0">
                    <Run Text="{Binding Row.Phone, Mode=OneWay}"/>
                    <Run Text="  ·  "/>
                    <Run Text="{loc:Loc Debt}"/>
                    <Run Text=" "/>
                    <Run Text="{Binding Row.Debet, Mode=OneWay, StringFormat=0.##}"/>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,12,0"
                        Visibility="{Binding ShowContent, Converter={StaticResource BoolToVis}}">
                <RadioButton GroupName="ClientWorkspaceTabs"
                             Content="{loc:Loc Overview}"
                             Style="{StaticResource CompactWorkspaceTab}"
                             IsChecked="{Binding IsOverview, Mode=OneWay}"
                             Command="{Binding SelectTabCommand}"
                             CommandParameter="{x:Static vm:ClientWorkspaceTab.Overview}"/>
                <RadioButton GroupName="ClientWorkspaceTabs"
                             Content="{loc:Loc ToothChart}"
                             Style="{StaticResource CompactWorkspaceTab}"
                             Margin="0"
                             IsChecked="{Binding IsDentalChart, Mode=OneWay}"
                             Command="{Binding SelectTabCommand}"
                             CommandParameter="{x:Static vm:ClientWorkspaceTab.DentalChart}"/>
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding ShowContent, Converter={StaticResource BoolToVis}}">
                <Button Content="{loc:Loc Edit}"
                        Command="{Binding EditCommand}"
                        Style="{StaticResource ModernButton}"
                        Height="28" MinWidth="72" Padding="12,2" Margin="0,0,6,0"
                        ToolTip="{loc:Loc Edit}"
                        Visibility="{Binding IsOverview, Converter={StaticResource BoolToVis}}"/>
                <Button x:Name="MoreButton"
                        Style="{StaticResource IconButton}"
                        Content="&#xE712;"
                        ToolTip="{loc:Loc More}"
                        Click="More_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Visibility="{Binding ShowContent, Converter={StaticResource BoolToVis}}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsOverview, Converter={StaticResource BoolToVis}}">
                    <WrapPanel>
                        <Border Style="{StaticResource Card}" Width="280" Margin="0,0,16,16" Padding="20">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Contact}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                                <TextBlock Text="{loc:Loc Phone}" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding Row.Phone}" Style="{StaticResource Body}" Margin="0,2,0,12"/>
                                <TextBlock Text="{loc:Loc FullName}" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding Row.FullName}" Style="{StaticResource Body}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Width="280" Margin="0,0,16,16" Padding="20">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Financial}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                                <TextBlock Text="{loc:Loc Price}" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding Row.Price, StringFormat=0.##}" Style="{StaticResource Body}" Margin="0,2,0,12"/>
                                <TextBlock Text="{loc:Loc Debt}" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding Row.Debet, StringFormat=0.##}" Style="{StaticResource Body}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Width="280" Margin="0,0,16,16" Padding="20">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc RegistrationDate}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                                <TextBlock Text="{loc:Loc DayOfRegistration}" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding Row.DateJoin, StringFormat=yyyy-MM-dd HH:mm}" Style="{StaticResource Body}" Margin="0,2,0,12"/>
                                <TextBlock Text="{loc:Loc DoubleVisit}" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding Row.Reminder, StringFormat=yyyy-MM-dd HH:mm}" Style="{StaticResource Body}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </ScrollViewer>

                <ContentControl Content="{Binding Chart}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Visibility="{Binding IsDentalChart, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{loc:Loc LoadingPatient}" Style="{StaticResource SectionTitle}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding NotFound, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{loc:Loc ClientNotFound}" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
            <Button Content="{Binding BackLabel}" Command="{Binding BackCommand}"
                    Style="{StaticResource SecondaryButton}" Margin="0,16,0,0" Height="36" Padding="16,6"
                    HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>

<UserControl x:Class="MyOrganizer.Wpf.MVVM.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Style="{StaticResource Card}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                MaxWidth="560" Padding="28" Margin="8">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding Message}" Style="{StaticResource Body}"
                           Margin="0,10,0,20" TextWrapping="Wrap"/>
                <Button Content="{Binding ActionLabel}"
                        Command="{Binding OpenLegacyCommand}"
                        Style="{StaticResource ModernButton}"
                        HorizontalAlignment="Left"
                        MinWidth="180" Height="36"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

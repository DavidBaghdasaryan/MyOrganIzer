<UserControl x:Class="MyOrganizer.Wpf.MVVM.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
        <StackPanel>
            <TextBlock Text="{Binding Welcome}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{Binding Hint}" Style="{StaticResource Body}"
                       Margin="0,8,0,24" MaxWidth="720" HorizontalAlignment="Left"/>

            <Border Style="{StaticResource Card}" MaxWidth="720" HorizontalAlignment="Left" Padding="20">
                <StackPanel>
                    <TextBlock Text="{Binding AppointmentsTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding Appointments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,8" BorderBrush="{StaticResource Brush.Border}"
                                        BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding}" Style="{StaticResource Body}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding EmptyAppointments}" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="MyOrganizer.Wpf.MVVM.Views.Suppliers.SupplierWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MyOrganizer.Wpf.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Command="{Binding BackCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Height="28" Padding="10,2" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding BackLabel}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                        <Run Text="{Binding Phone, Mode=OneWay}"/>
                        <Run Text="  ·  "/>
                        <Run Text="{Binding Email, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="2" Content="{loc:Loc Edit}" Command="{Binding EditCommand}"
                        Style="{StaticResource SecondaryButton}" Height="36" MinWidth="100"/>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16"
                    Visibility="{Binding ShowContent, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc SupplierDetails}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding Notes}" Style="{StaticResource Body}" Margin="0,8,0,0"
                               Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,16" Visibility="{Binding ShowContent, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="{loc:Loc Products}" Style="{StaticResource SectionTitle}"/>
                            <Button Content="{loc:Loc AddProduct}" Command="{Binding AddProductCommand}"
                                    Style="{StaticResource ModernButton}" Height="32" MinWidth="120"
                                    HorizontalAlignment="Right"/>
                        </Grid>
                        <DataGrid Grid.Row="2" Style="{StaticResource ModernDataGrid}" Height="220"
                                  ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                                  MouseDoubleClick="ProductsGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Name}" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="{loc:Loc Unit}" Binding="{Binding UnitDisplay}" Width="0.5*"/>
                                <DataGridTextColumn Header="{loc:Loc DefaultPrice}" Binding="{Binding PriceDisplay}" Width="0.7*"/>
                                <DataGridTemplateColumn Width="88" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SecondaryButton}"
                                                    Content="{loc:Loc Delete}"
                                                    Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Height="28" Padding="12,4" HorizontalAlignment="Right"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" Text="{loc:Loc NoProductsYet}" Style="{StaticResource Body}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ShowProductsEmpty, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="{loc:Loc Services}" Style="{StaticResource SectionTitle}"/>
                            <Button Content="{loc:Loc AddService}" Command="{Binding AddServiceCommand}"
                                    Style="{StaticResource ModernButton}" Height="32" MinWidth="120"
                                    HorizontalAlignment="Right"/>
                        </Grid>
                        <DataGrid Grid.Row="2" Style="{StaticResource ModernDataGrid}" Height="220"
                                  ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}"
                                  MouseDoubleClick="ServicesGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Name}" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="{loc:Loc Unit}" Binding="{Binding UnitDisplay}" Width="0.5*"/>
                                <DataGridTextColumn Header="{loc:Loc DefaultPrice}" Binding="{Binding PriceDisplay}" Width="0.7*"/>
                                <DataGridTemplateColumn Width="88" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SecondaryButton}"
                                                    Content="{loc:Loc Delete}"
                                                    Command="{Binding DataContext.DeleteServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Height="28" Padding="12,4" HorizontalAlignment="Right"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" Text="{loc:Loc NoServicesYet}" Style="{StaticResource Body}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ShowServicesEmpty, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="16"
                    Visibility="{Binding ShowContent, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="{loc:Loc ExpenseHistory}" Style="{StaticResource SectionTitle}"/>
                        <Button Content="{loc:Loc AddExpense}" Command="{Binding AddExpenseCommand}"
                                Style="{StaticResource ModernButton}" Height="32" MinWidth="120"
                                HorizontalAlignment="Right"/>
                    </Grid>
                    <DataGrid Grid.Row="2" Style="{StaticResource ModernDataGrid}" Height="200"
                              ItemsSource="{Binding Expenses}" SelectedItem="{Binding SelectedExpense}"
                              Visibility="{Binding ShowExpensesGrid, Converter={StaticResource BoolToVis}}"
                              MouseDoubleClick="ExpensesGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc TransactionDate}" Binding="{Binding DateDisplay}" Width="0.8*"/>
                            <DataGridTextColumn Header="{loc:Loc Reference}" Binding="{Binding Reference}" Width="*"/>
                            <DataGridTextColumn Header="{loc:Loc Total}" Binding="{Binding TotalDisplay}" Width="0.7*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="{loc:Loc NoExpenseHistory}" Style="{StaticResource Body}"
                               HorizontalAlignment="Center" Margin="0,24"
                               Visibility="{Binding ShowExpensesEmpty, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

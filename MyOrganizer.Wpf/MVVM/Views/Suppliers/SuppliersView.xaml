<UserControl x:Class="MyOrganizer.Wpf.MVVM.Views.Suppliers.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MyOrganizer.Wpf.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{loc:Loc Suppliers}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{loc:Loc SuppliersSubtitle}" Style="{StaticResource Body}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="{loc:Loc AddSupplier}"
                    Command="{Binding AddCommand}"
                    Style="{StaticResource ModernButton}"
                    MinWidth="148" Height="36"
                    VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Height="36"
                         Style="{StaticResource ModernTextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{loc:Loc SearchSuppliers}"
                         VerticalContentAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="{loc:Loc Clear}"
                        Command="{Binding ClearSearchCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Height="36"
                        Padding="12,6"
                        Margin="12,0,0,0"
                        Visibility="{Binding HasActiveFilter, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid x:Name="SuppliersGrid"
                          Style="{StaticResource ModernDataGrid}"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedRow}"
                          Visibility="{Binding ShowGrid, Converter={StaticResource BoolToVis}}"
                          MouseDoubleClick="SuppliersGrid_MouseDoubleClick">
                    <DataGrid.InputBindings>
                        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
                        <KeyBinding Key="Enter" Command="{Binding OpenCommand}"/>
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc Name}" Binding="{Binding Name}" Width="1.6*"/>
                        <DataGridTextColumn Header="{loc:Loc Phone}" Binding="{Binding Phone}" Width="1*"/>
                        <DataGridTextColumn Header="{loc:Loc Email}" Binding="{Binding Email}" Width="1.2*"/>
                        <DataGridTemplateColumn Width="180" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Content="{loc:Loc Open}"
                                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Height="28" Padding="12,4" Margin="0,0,4,0"/>
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Content="{loc:Loc Delete}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Height="28" Padding="12,4"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding ShowEmptyDatabase, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:Loc NoSuppliersYet}" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc AddFirstSupplier}" Style="{StaticResource Body}" Margin="0,8,0,16" HorizontalAlignment="Center"/>
                    <Button Content="{loc:Loc AddSupplier}" Command="{Binding AddCommand}"
                            Style="{StaticResource ModernButton}" HorizontalAlignment="Center" MinWidth="148" Height="36"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding ShowEmptyFilter, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:Loc NoSuppliersFound}" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc TryChangingFilters}" Style="{StaticResource Body}" Margin="0,8,0,16" HorizontalAlignment="Center"/>
                    <Button Content="{loc:Loc Clear}" Command="{Binding ClearSearchCommand}"
                            Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Height="36" Padding="16,6"/>
                </StackPanel>

                <Border Background="#99FFFFFF"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="…" Style="{StaticResource SectionTitle}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>

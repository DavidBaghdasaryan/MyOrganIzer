<UserControl x:Class="MyOrganizer.Wpf.MVVM.Views.Settings.PricesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MyOrganizer.Wpf.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{loc:Loc SetPrices}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{loc:Loc ProceduresSubtitle}" Style="{StaticResource Body}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding Error}" Style="{StaticResource FieldError}" Margin="0,8,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{loc:Loc AddProcedure}" Command="{Binding AddCommand}"
                        Style="{StaticResource SecondaryButton}" MinWidth="148" Height="36" Margin="0,0,8,0"/>
                <Button Content="{loc:Loc Save}" Command="{Binding SaveCommand}"
                        Style="{StaticResource ModernButton}" MinWidth="120" Height="36"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Height="36" Style="{StaticResource ModernTextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{loc:Loc SearchProcedures}"/>
                <Button Grid.Column="1" Content="{loc:Loc Clear}" Command="{Binding ClearSearchCommand}"
                        Style="{StaticResource SecondaryButton}" Height="36" Padding="12,6" Margin="12,0,0,0"
                        Visibility="{Binding HasActiveFilter, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid Style="{StaticResource ModernDataGrid}" RowHeight="56"
                          ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedRow}"
                          Visibility="{Binding ShowGrid, Converter={StaticResource BoolToVis}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc Type}" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="{loc:Loc Tier1}" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Style="{StaticResource ModernTextBox}" Height="36" Margin="8,6"
                                             TextAlignment="Right"
                                             Text="{Binding Tier1, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{loc:Loc Tier2}" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Style="{StaticResource ModernTextBox}" Height="36" Margin="8,6"
                                             TextAlignment="Right"
                                             Text="{Binding Tier2, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{loc:Loc Tier3}" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Style="{StaticResource ModernTextBox}" Height="36" Margin="8,6"
                                             TextAlignment="Right"
                                             Text="{Binding Tier3, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="96" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="{loc:Loc Delete}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Height="28" Padding="12,4" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding ShowEmptyDatabase, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:Loc NoProceduresYet}" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
                    <Button Content="{loc:Loc AddProcedure}" Command="{Binding AddCommand}"
                            Style="{StaticResource ModernButton}" HorizontalAlignment="Center" MinWidth="148" Height="36" Margin="0,16,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding ShowEmptyFilter, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:Loc NoProceduresFound}" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
                    <Button Content="{loc:Loc Clear}" Command="{Binding ClearSearchCommand}"
                            Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Height="36" Margin="0,16,0,0" Padding="16,6"/>
                </StackPanel>
                <Border Background="#99FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="…" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>

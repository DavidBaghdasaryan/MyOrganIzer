<UserControl x:Class="MyOrganizer.Wpf.MVVM.Views.DentalChart.EndodonticProcedureContextView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MyOrganizer.Wpf.Localization">
    <StackPanel>
        <TextBlock Text="{Binding ProcedureName}"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource Brush.TextPrimary}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4"/>
        <TextBlock Text="{loc:Loc EndodonticContextHint}"
                   Style="{StaticResource Caption}"
                   Opacity="0.85"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <Border MinHeight="88"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{StaticResource Brush.Surface}"
                Margin="0,0,0,12"
                Padding="10">
            <TextBlock Text="{loc:Loc CanalVisualPlaceholder}"
                       Style="{StaticResource Caption}"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"/>
        </Border>

        <TextBlock Text="{loc:Loc Price}" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
        <ListBox Style="{StaticResource DialogListBox}"
                 Height="96"
                 ItemsSource="{Binding Tiers}"
                 SelectedItem="{Binding SelectedTier}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                                 Fill="{Binding Marker}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Display}" VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.TextPrimary}"
                                   FontSize="12"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{loc:Loc Cancel}"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Height="32" MinWidth="80" Margin="0,0,8,0"/>
            <Button Content="{loc:Loc Apply}"
                    Command="{Binding ApplyCommand}"
                    Style="{StaticResource ModernButton}"
                    Height="32" MinWidth="88"/>
        </StackPanel>
    </StackPanel>
</UserControl>

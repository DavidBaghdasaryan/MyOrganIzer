<UserControl x:Class="MyOrganizer.Wpf.MVVM.Views.DentalChart.DentalChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MyOrganizer.Wpf.Localization"
             xmlns:controls="clr-namespace:MyOrganizer.Wpf.Controls"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             SizeChanged="OnChartSizeChanged">
    <Grid>
        <Grid x:Name="WorkspaceGrid" Visibility="{Binding HasError, Converter={StaticResource InverseBoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="InspectorRow" Height="0"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="InspectorCol" Width="300"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.ColumnSpan="2"
                       Text="{loc:Loc ToothChartHint}"
                       Style="{StaticResource Caption}"
                       Opacity="0.85"
                       Margin="0,0,0,6"
                       TextWrapping="Wrap"/>

            <Border Grid.Row="1"
                    Margin="0,0,10,0"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8,4"
                    ClipToBounds="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <controls:OdontogramView x:Name="ProductionOdontogram"
                                                 HorizontalAlignment="Stretch"/>

                        <TextBlock Text="{Binding Status}"
                                   Style="{StaticResource Caption}"
                                   Margin="0,10,0,8"
                                   TextWrapping="Wrap"/>

                        <Border Margin="0,0,0,8" Padding="16" HorizontalAlignment="Stretch"
                                Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <TextBlock Text="This FDI is not imported yet."
                                       Style="{StaticResource Body}" TextWrapping="Wrap"/>
                        </Border>

                        <Border Margin="0,0,0,8"
                                HorizontalAlignment="Center"
                                CornerRadius="8" ClipToBounds="True"
                                Width="{Binding ToothSize}" Height="{Binding ToothSize}"
                                Background="#C8CED6"
                                Visibility="{Binding ShowEmptyImplantViewer, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>

                        <Border Margin="0,0,0,8"
                                HorizontalAlignment="Center"
                                CornerRadius="8" ClipToBounds="True"
                                Width="{Binding ToothSize}" Height="{Binding ToothSize}"
                                Visibility="{Binding ShowDetailedViewer, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <controls:ToothMeshView x:Name="MeshView"/>
                        </Border>

                        <WrapPanel Margin="0,0,0,8"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding ShowDetailedViewer, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <Button Content="Occlusal View" Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,8" Padding="12,6" Click="OnOcclusal"/>
                            <Button Content="Buccal" Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,8" Padding="12,6" Click="OnBuccal"/>
                            <Button Content="{Binding InnerCameraLabel}" Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,8" Padding="12,6" Click="OnPalatal"/>
                            <Button Content="Mesial" Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,8" Padding="12,6" Click="OnMesial"/>
                            <Button Content="Distal" Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,8" Padding="12,6" Click="OnDistal"/>
                            <Button Content="Reset View" Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,8" Padding="12,6" Click="OnOcclusal"/>
                        </WrapPanel>

                        <StackPanel Margin="0,0,0,8"
                                    Visibility="{Binding ShowDetailedViewer, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <TextBlock Text="{Binding ToothSize, StringFormat=3D viewport: {0:0} px}"
                                       Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                            <Slider Minimum="220" Maximum="360" Value="{Binding ToothSize}"
                                    TickFrequency="10" IsSnapToTickEnabled="False"
                                    SmallChange="2" LargeChange="20"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="InspectorHost"
                    Grid.Row="1"
                    Grid.Column="1"
                    Background="{StaticResource Brush.SurfaceSecondary}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,12"
                    MinWidth="200">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc NoSurfaceSelected}"
                                   Style="{StaticResource Body}"
                                   TextWrapping="Wrap"
                                   Opacity="0.85"
                                   Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}"/>

                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:Loc SelectedTooth}" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding SelectedTooth}"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextPrimary}"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding SelectedVisualType}"
                                       Style="{StaticResource Body}"
                                       Opacity="0.9"
                                       Margin="0,0,0,10"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowClinicalTools, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Procedure" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Margin="0,10,0,4" Style="{StaticResource Caption}"
                                       Text="{Binding EditorStatus}"/>
                            <TextBlock Margin="0,0,0,4" Style="{StaticResource Caption}"
                                       Text="{Binding SelectedSurfacesLabel, StringFormat=Selected surfaces: {0}}"
                                       Visibility="{Binding ShowSurfacePicker, Converter={StaticResource BoolToVis}}"/>
                            <ItemsControl ItemsSource="{Binding SurfaceChoices}" Margin="0,4,0,8"
                                          Visibility="{Binding ShowSurfacePicker, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,0,0,4" Style="{StaticResource Caption}"
                                       Text="{Binding SelectedCanalsLabel, StringFormat=Selected roots/canals: {0}}"
                                       Visibility="{Binding ShowCanalPicker, Converter={StaticResource BoolToVis}}"/>
                            <ItemsControl ItemsSource="{Binding CanalChoices}" Margin="0,4,0,8"
                                          Visibility="{Binding ShowCanalPicker, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Whole-tooth procedure — surfaces are not required."
                                       Style="{StaticResource Caption}" Margin="0,0,0,8"
                                       Visibility="{Binding ShowWholeToothHint, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="Procedure type" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding ProcedureTypeChoices}"
                                      SelectedValue="{Binding SelectedProcedureType, Mode=TwoWay}"
                                      SelectedValuePath="Type"
                                      DisplayMemberPath="Name"
                                      Margin="0,0,0,8"/>
                            <TextBlock Text="{loc:Loc Price}" Style="{StaticResource Caption}" Margin="0,0,0,6"
                                       Visibility="{Binding ShowPriceTiers, Converter={StaticResource BoolToVis}}"/>
                            <ListBox Style="{StaticResource DialogListBox}"
                                     Height="96"
                                     Margin="0,0,0,8"
                                     ItemsSource="{Binding PriceTiers}"
                                     SelectedItem="{Binding SelectedPriceTier}"
                                     Visibility="{Binding ShowPriceTiers, Converter={StaticResource BoolToVis}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                                                     Fill="{Binding Marker}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Display}" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Brush.TextPrimary}"
                                                       FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel>
                                <Button Content="Create Procedure" Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,8" Padding="12,6"
                                        Command="{Binding CreateProcedureCommand}"/>
                                <Button Content="Save Procedure" Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,8" Padding="12,6"
                                        Command="{Binding SaveProcedureCommand}"/>
                                <Button Content="New Procedure" Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,8" Padding="12,6"
                                        Command="{Binding NewProcedureCommand}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding ClinicalSummary}" Style="{StaticResource Body}"
                                       Margin="0,4,0,12"/>
                            <TextBlock Text="Procedures" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                            <TextBlock Text="No procedure records yet."
                                       Style="{StaticResource Caption}"
                                       Margin="0,0,0,8"
                                       Visibility="{Binding HasProcedures, Converter={StaticResource InverseBoolToVis}}"/>
                            <ItemsControl ItemsSource="{Binding ProcedureItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="True" Margin="0,0,0,10">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Vertical"
                                                        VerticalAlignment="Top" Margin="8,0,0,0">
                                                <Button Content="Edit"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="10,4" Margin="0,0,0,6"
                                                        Command="{Binding EditCommand}"/>
                                                <Button Content="Remove"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="10,4"
                                                        Command="{Binding RemoveCommand}"/>
                                            </StackPanel>
                                            <StackPanel MinWidth="0" HorizontalAlignment="Stretch">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" TextTrimming="None"
                                                           Foreground="{StaticResource Brush.TextPrimary}"/>
                                                <TextBlock Text="{Binding SurfacesDisplay}"
                                                           Style="{StaticResource Caption}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{loc:Loc ChartLoadFailed}"
                       Style="{StaticResource SectionTitle}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
            <TextBlock Text="{Binding Error}"
                       Style="{StaticResource Body}"
                       Margin="0,8,0,0"
                       MaxWidth="480"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"/>
            <Button Content="{loc:Loc Retry}"
                    Command="{Binding RetryCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Height="36"
                    Padding="16,6"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"/>
        </StackPanel>

        <Border Background="#AAF4F6F9"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                IsHitTestVisible="True">
            <TextBlock Text="{loc:Loc LoadingChart}"
                       Style="{StaticResource SectionTitle}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>

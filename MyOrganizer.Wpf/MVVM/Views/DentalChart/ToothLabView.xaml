<UserControl x:Class="MyOrganizer.Wpf.MVVM.Views.DentalChart.ToothLabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MyOrganizer.Wpf.Controls">
    <UserControl.Resources>
        <Style x:Key="FdiSlotButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,14,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding LabTitle}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}"
                               Margin="0,6,0,8" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding ChartRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Jaw}" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <ItemsControl ItemsSource="{Binding Right}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Fdi}" Style="{StaticResource FdiSlotButton}"
                                                            Command="{Binding DataContext.SelectToothCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Fdi}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="|" Margin="6,0,10,0" VerticalAlignment="Center"
                                                   Style="{StaticResource Caption}"/>
                                        <ItemsControl ItemsSource="{Binding Left}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Fdi}" Style="{StaticResource FdiSlotButton}"
                                                            Command="{Binding DataContext.SelectToothCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Fdi}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Border Grid.Row="1" Margin="0,16,0,8" Padding="16"
                        Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding PlaceholderBody}" Style="{StaticResource Body}"
                               TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"/>
                </Border>

                <Border Grid.Row="1" Margin="0,8,0,16" HorizontalAlignment="Center"
                        CornerRadius="8" ClipToBounds="True"
                        Width="{Binding ToothSize}" Height="{Binding ToothSize}"
                        Visibility="{Binding ShowInspector, Converter={StaticResource BoolToVis}}">
                    <controls:ToothMeshView x:Name="MeshView"/>
                </Border>

                <WrapPanel Grid.Row="2" Margin="0,4,0,8"
                           Visibility="{Binding ShowInspector, Converter={StaticResource BoolToVis}}">
                    <Button Content="Occlusal View" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,8" Padding="12,6" Click="OnOcclusal"/>
                    <Button Content="Buccal" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,8" Padding="12,6" Click="OnBuccal"/>
                    <Button Content="{Binding InnerCameraLabel}" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,8" Padding="12,6" Click="OnPalatal"/>
                    <Button Content="Mesial" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,8" Padding="12,6" Click="OnMesial"/>
                    <Button Content="Distal" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,8" Padding="12,6" Click="OnDistal"/>
                    <Button Content="Reset View" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,8" Padding="12,6" Click="OnOcclusal"/>
                </WrapPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10"
                            Visibility="{Binding ShowClinicalTools, Converter={StaticResource BoolToVis}}">
                    <CheckBox x:Name="ShowSegCheck" Content="Show Surface Segmentation"
                              VerticalAlignment="Center"
                              Checked="OnSegChanged" Unchecked="OnSegChanged"/>
                    <TextBlock Text="Inspect" Margin="18,0,8,0" VerticalAlignment="Center"
                               Style="{StaticResource Caption}"/>
                    <ComboBox x:Name="InspectCombo" Width="128" SelectedIndex="0"
                              VerticalAlignment="Center" SelectionChanged="OnSegChanged">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Occlusal"/>
                        <ComboBoxItem Content="Buccal"/>
                        <ComboBoxItem Content="Palatal"/>
                        <ComboBoxItem Content="Mesial"/>
                        <ComboBoxItem Content="Distal"/>
                    </ComboBox>
                </StackPanel>

                <TextBlock Grid.Row="4" Text="{Binding Status}" Style="{StaticResource Body}"
                           TextWrapping="Wrap" Margin="0,0,0,12"
                           FontFamily="Consolas" FontSize="13"/>

                <StackPanel Grid.Row="5"
                            Visibility="{Binding ShowInspector, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ToothSize, StringFormat=3D viewport: {0:0} px}"
                               Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                    <Slider Minimum="250" Maximum="360" Value="{Binding ToothSize}"
                            TickFrequency="10" IsSnapToTickEnabled="False"
                            SmallChange="2" LargeChange="20"/>
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Selected asset" Style="{StaticResource Caption}" Margin="0,0,0,8"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding PlaceholderBody}" Style="{StaticResource Caption}"
                               TextWrapping="Wrap" Margin="0,0,0,16"
                               Visibility="{Binding ShowAssetStatus, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel Visibility="{Binding ShowClinicalTools, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Procedure" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Margin="0,10,0,4" Style="{StaticResource Caption}"
                               Text="{Binding EditorStatus}"/>
                    <TextBlock Margin="0,0,0,4" Style="{StaticResource Caption}"
                               Text="{Binding SelectedSurfacesLabel, StringFormat=Selected surfaces: {0}}"/>
                    <ItemsControl ItemsSource="{Binding SurfaceChoices}" Margin="0,4,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Procedure type: Filling" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <Button Content="Create Procedure" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,8" Padding="12,6"
                                Command="{Binding CreateProcedureCommand}"/>
                        <Button Content="Save Procedure" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,8" Padding="12,6"
                                Command="{Binding SaveProcedureCommand}"/>
                        <Button Content="New Procedure" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,8" Padding="12,6"
                                Command="{Binding NewProcedureCommand}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding ClinicalSummary}" Style="{StaticResource Body}"
                               Margin="0,4,0,12"/>
                    <TextBlock Text="Procedures" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="No procedure records yet."
                               Style="{StaticResource Caption}"
                               Margin="0,0,0,8"
                               Visibility="{Binding HasProcedures, Converter={StaticResource InverseBoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding ProcedureItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.TextPrimary}"/>
                                            <TextBlock Text="{Binding SurfacesDisplay}"
                                                       Style="{StaticResource Caption}"
                                                       TextWrapping="Wrap" Margin="0,2,8,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Edit"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="10,4" VerticalAlignment="Top"
                                                Command="{Binding EditCommand}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource Caption}"
                               Margin="0,16,0,0"
                               Text="{Binding InspectorNote}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="MyOrganizer.Wpf.MVVM.Views.Dialogs.EditSupplierDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MyOrganizer.Wpf.Localization"
             Width="480"
             Focusable="True"
             Loaded="View_Loaded">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
        <KeyBinding Key="Return" Command="{Binding SaveCommand}"/>
    </UserControl.InputBindings>
    <Border Style="{StaticResource DialogSurface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Padding="20,16" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding Title}" Style="{StaticResource DialogTitle}"/>
            </Border>

            <StackPanel Grid.Row="1" Margin="20,16">
                <TextBlock Text="{loc:Loc Name}" Style="{StaticResource Caption}"/>
                <TextBox x:Name="NameBox" Style="{StaticResource ModernTextBox}" Height="36" Margin="0,4,0,0"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{Binding NameError}" Style="{StaticResource FieldError}"
                           Visibility="{Binding HasNameError, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Text="{loc:Loc Phone}" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
                <TextBox Style="{StaticResource ModernTextBox}" Height="36" Margin="0,4,0,0"
                         Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="{loc:Loc Email}" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
                <TextBox Style="{StaticResource ModernTextBox}" Height="36" Margin="0,4,0,0"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="{loc:Loc Notes}" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
                <TextBox Style="{StaticResource ModernTextBox}" Height="72" Margin="0,4,0,0"
                         Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap" AcceptsReturn="True"/>
            </StackPanel>

            <Border Grid.Row="2" Padding="20,12" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Loc Cancel}"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Height="36" MinWidth="100" Margin="0,0,8,0"/>
                    <Button Content="{loc:Loc Save}"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource ModernButton}"
                            Height="36" MinWidth="108"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>

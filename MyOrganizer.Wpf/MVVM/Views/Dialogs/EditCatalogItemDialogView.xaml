<UserControl x:Class="MyOrganizer.Wpf.MVVM.Views.Dialogs.EditCatalogItemDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MyOrganizer.Wpf.Localization"
             Width="640" Focusable="True" Loaded="View_Loaded">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </UserControl.InputBindings>
    <Border Style="{StaticResource DialogSurface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Padding="20,16" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding Title}" Style="{StaticResource DialogTitle}"/>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="520">
                <StackPanel Margin="20,16">
                    <TextBlock Text="{loc:Loc ProductOrService}" Style="{StaticResource Caption}"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource ModernTextBox}" Height="36" Margin="0,4,0,0"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{Binding NameError}" Style="{StaticResource FieldError}"
                               Visibility="{Binding HasNameError, Converter={StaticResource BoolToVis}}"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Kind}" Style="{StaticResource Caption}"/>
                            <ComboBox Style="{StaticResource ModernComboBox}" Height="36" Margin="0,4,0,0"
                                      ItemsSource="{Binding KindOptions}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding Kind}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:Loc Unit}" Style="{StaticResource Caption}"/>
                            <ComboBox Style="{StaticResource ModernComboBox}" Height="36" Margin="0,4,0,0"
                                      ItemsSource="{Binding Units}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding Unit}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{loc:Loc Notes}" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Height="56" Margin="0,4,0,0"
                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:Loc AssociatedSuppliers}" Style="{StaticResource SectionTitle}" Margin="0,16,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Supplier}" Style="{StaticResource Caption}"/>
                            <ComboBox Style="{StaticResource ModernComboBox}" Height="36" Margin="0,4,0,0"
                                      ItemsSource="{Binding SupplierChoices}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedSupplier}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:Loc SupplierPrice}" Style="{StaticResource Caption}"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Height="36" Margin="0,4,0,0"
                                     MinWidth="220" TextAlignment="Right"
                                     Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ExtraLinks}" Margin="0,8,0,0"
                                  Visibility="{Binding ShowExtraLinks, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource ModernTextBox}" Height="36"
                                             MinWidth="220" TextAlignment="Right"
                                             Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="4" Style="{StaticResource SecondaryButton}"
                                            Content="{loc:Loc Delete}" Height="36" Padding="12,4"
                                            Command="{Binding DataContext.RemoveSupplierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Padding="20,12" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Loc Cancel}" Command="{Binding CancelCommand}"
                            Style="{StaticResource SecondaryButton}" Height="36" MinWidth="100" Margin="0,0,8,0"/>
                    <Button Content="{loc:Loc Save}" Command="{Binding SaveCommand}"
                            Style="{StaticResource ModernButton}" Height="36" MinWidth="108"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>

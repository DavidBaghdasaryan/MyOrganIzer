<UserControl x:Class="MyOrganizer.Wpf.MVVM.Views.Dialogs.UnitsDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MyOrganizer.Wpf.Localization"
             Width="480">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </UserControl.InputBindings>
    <Border Style="{StaticResource DialogSurface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Padding="20,16" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource DialogTitle}"/>
                    <Button Content="{loc:Loc AddUnit}" Command="{Binding AddCommand}"
                            Style="{StaticResource ModernButton}" Height="32" MinWidth="110" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="20,16" MinHeight="240">
                <Grid Visibility="{Binding ShowList, Converter={StaticResource BoolToVis}}">
                    <DataGrid Style="{StaticResource ModernDataGrid}" Height="240"
                              ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Unit}" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="{loc:Loc BaseUnit}" Binding="{Binding BaseUnit.Name}" Width="0.8*"/>
                            <DataGridTextColumn Header="{loc:Loc ConversionFactor}" Binding="{Binding ConversionFactor}" Width="0.6*"/>
                            <DataGridTemplateColumn Width="72">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource IconButton}" Content="&#xE70F;" Width="28" Height="28"
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Width="28" Height="28"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:Loc Unit}" Style="{StaticResource Caption}"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Height="36" Margin="0,4,0,0"
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{Binding NameError}" Style="{StaticResource FieldError}"
                               Visibility="{Binding HasNameError, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{loc:Loc ConversionHint}" Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Style="{StaticResource ModernComboBox}" Height="36"
                                  ItemsSource="{Binding BaseChoices}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding EditBase}"/>
                        <TextBox Grid.Column="2" Style="{StaticResource ModernTextBox}" Height="36"
                                 Text="{Binding EditFactor, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="{loc:Loc Cancel}" Command="{Binding CancelEditCommand}"
                                Style="{StaticResource SecondaryButton}" Height="32" MinWidth="90" Margin="0,0,8,0"/>
                        <Button Content="{loc:Loc Save}" Command="{Binding SaveEditCommand}"
                                Style="{StaticResource ModernButton}" Height="32" MinWidth="90"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Border Grid.Row="2" Padding="20,12" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
                <Button Content="{loc:Loc Cancel}" Command="{Binding CloseCommand}"
                        Style="{StaticResource SecondaryButton}" Height="36" MinWidth="100" HorizontalAlignment="Right"/>
            </Border>
        </Grid>
    </Border>
</UserControl>

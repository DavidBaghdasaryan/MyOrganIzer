<UserControl x:Class="MyOrganizer.Wpf.MVVM.Views.Dialogs.AssociateCatalogItemDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MyOrganizer.Wpf.Localization"
             Width="420">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
        <KeyBinding Key="Return" Command="{Binding SaveCommand}"/>
    </UserControl.InputBindings>
    <Border Style="{StaticResource DialogSurface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Padding="20,16" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding Title}" Style="{StaticResource DialogTitle}"/>
            </Border>
            <StackPanel Grid.Row="1" Margin="20,16">
                <TextBlock Text="{loc:Loc ProductOrService}" Style="{StaticResource Caption}"/>
                <ComboBox Style="{StaticResource ModernComboBox}" Height="36" Margin="0,4,0,0"
                          ItemsSource="{Binding Items}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedItem}"/>
                <TextBlock Text="{Binding ItemError}" Style="{StaticResource FieldError}"
                           Visibility="{Binding HasItemError, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{loc:Loc SupplierPrice}" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
                <TextBox Style="{StaticResource ModernTextBox}" Height="36" Margin="0,4,0,0"
                         Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="{loc:Loc CreateNewCatalogItem}" Command="{Binding CreateNewCommand}"
                        Style="{StaticResource SecondaryButton}" Height="32" Margin="0,16,0,0" HorizontalAlignment="Left"/>
            </StackPanel>
            <Border Grid.Row="2" Padding="20,12" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Loc Cancel}" Command="{Binding CancelCommand}"
                            Style="{StaticResource SecondaryButton}" Height="36" MinWidth="100" Margin="0,0,8,0"/>
                    <Button Content="{loc:Loc Save}" Command="{Binding SaveCommand}"
                            Style="{StaticResource ModernButton}" Height="36" MinWidth="108"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>

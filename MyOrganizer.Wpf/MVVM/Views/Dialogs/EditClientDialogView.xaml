<UserControl x:Class="MyOrganizer.Wpf.MVVM.Views.Dialogs.EditClientDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MyOrganizer.Wpf.Localization"
             Width="520"
             Focusable="True"
             Loaded="View_Loaded">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
        <KeyBinding Key="Return" Command="{Binding SaveCommand}"/>
    </UserControl.InputBindings>
    <Border Style="{StaticResource DialogSurface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Padding="20,16" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding Title}" Style="{StaticResource DialogTitle}"/>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="520">
                <StackPanel Margin="20,16">
                    <TextBlock Text="{loc:Loc FirstName}" Style="{StaticResource Caption}"/>
                    <TextBox x:Name="FirstNameBox" Style="{StaticResource ModernTextBox}" Height="36" Margin="0,4,0,0"
                             Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{Binding FirstNameError}" Style="{StaticResource FieldError}"
                               Visibility="{Binding HasFirstNameError, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Text="{loc:Loc LastName}" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Height="36" Margin="0,4,0,0"
                             Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{Binding LastNameError}" Style="{StaticResource FieldError}"
                               Visibility="{Binding HasLastNameError, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Text="{loc:Loc MiddlName}" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Height="36" Margin="0,4,0,0"
                             Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{Binding MiddleNameError}" Style="{StaticResource FieldError}"
                               Visibility="{Binding HasMiddleNameError, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Text="{loc:Loc Phone}" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Height="36" Margin="0,4,0,0"
                             Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Price}" Style="{StaticResource Caption}"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Height="36" Margin="0,4,0,0"
                                     Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:Loc Debt}" Style="{StaticResource Caption}"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Height="36" Margin="0,4,0,0"
                                     Text="{Binding Debt, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{loc:Loc RegistrationDate}" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
                    <DatePicker Style="{StaticResource ModernDatePicker}" Margin="0,4,0,0"
                                SelectedDate="{Binding DateJoin}"/>

                    <CheckBox Margin="0,16,0,0"
                              Content="{loc:Loc ScheduleDoubleVisit}"
                              IsChecked="{Binding ScheduleDouble}"
                              Foreground="{StaticResource Brush.TextPrimary}"/>
                    <DatePicker Style="{StaticResource ModernDatePicker}"
                                Margin="0,8,0,0"
                                SelectedDate="{Binding DateDouble}"
                                Visibility="{Binding ScheduleDouble, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="20,12" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Loc Cancel}"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Height="36" MinWidth="100" Margin="0,0,8,0"/>
                    <Button Content="{loc:Loc Save}"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource ModernButton}"
                            Height="36" MinWidth="108"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>

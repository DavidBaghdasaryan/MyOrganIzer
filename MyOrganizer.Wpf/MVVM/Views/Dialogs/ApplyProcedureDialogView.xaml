<UserControl x:Class="MyOrganizer.Wpf.MVVM.Views.Dialogs.ApplyProcedureDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MyOrganizer.Wpf.Localization"
             Width="480"
             Focusable="True"
             Loaded="View_Loaded">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </UserControl.InputBindings>
    <Border Style="{StaticResource DialogSurface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Padding="20,16" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                <TextBlock Text="{loc:Loc ApplyProcedure}" Style="{StaticResource DialogTitle}"/>
            </Border>

            <StackPanel Grid.Row="1" Margin="20,16">
                <TextBlock Text="{loc:Loc SelectedTooth}" Style="{StaticResource Caption}"/>
                <TextBlock Text="{Binding ToothNumber}"
                           FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.TextPrimary}"
                           Margin="0,2,0,8"/>
                <TextBlock Text="{loc:Loc SelectedSurfaces}" Style="{StaticResource Caption}"/>
                <TextBlock Text="{Binding SurfacesDisplay}" Style="{StaticResource Body}" Margin="0,2,0,0"/>

                <TextBox x:Name="SearchBox"
                         Style="{StaticResource ModernTextBox}"
                         Height="36"
                         Margin="0,16,0,8"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{loc:Loc SearchProcedures}"/>

                <TextBlock Text="{loc:Loc Procedures}" Style="{StaticResource Caption}" Margin="0,4,0,6"/>
                <ListBox Style="{StaticResource DialogListBox}"
                         Height="168"
                         ItemsSource="{Binding FilteredProcedures}"
                         SelectedItem="{Binding SelectedProcedure}"/>

                <TextBlock Text="{loc:Loc Price}" Style="{StaticResource Caption}" Margin="0,14,0,6"/>
                <ListBox Style="{StaticResource DialogListBox}"
                         Height="108"
                         ItemsSource="{Binding Tiers}"
                         SelectedItem="{Binding SelectedTier}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Ellipse Width="10" Height="10" Margin="0,0,10,0"
                                         Fill="{Binding Marker}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.TextPrimary}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <Border Grid.Row="2" Padding="20,12" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock Text="{Binding Error}"
                               Style="{StaticResource FieldError}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="220"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{loc:Loc Cancel}"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Height="36" MinWidth="100" Margin="0,0,8,0"/>
                        <Button Content="{loc:Loc Apply}"
                                Command="{Binding ApplyCommand}"
                                Style="{StaticResource ModernButton}"
                                Height="36" MinWidth="108"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

<Window x:Class="MyOrganizer.Wpf.MVVM.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:MyOrganizer.Wpf.Controls"
        xmlns:loc="clr-namespace:MyOrganizer.Wpf.Localization"
        Title="{loc:Loc AppTitle}"
        Width="1360" Height="800"
        MinWidth="1100" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource Brush.AppBackground}"
        Closed="Window_Closed">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
        <Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" MinWidth="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <controls:AppSidebar Grid.Column="0"/>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="0,0,0,1"
                            MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding PageTitle}"
                                       Style="{StaticResource PageTitle}"
                                       FontSize="18"
                                       VerticalAlignment="Center"
                                       Margin="20,0,12,0"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource IconButton}"
                                        ToolTip="{loc:Loc Reminders}"
                                        Command="{Binding ShowRemindersCommand}"
                                        Visibility="{Binding HasReminders, Converter={StaticResource BoolToVis}}"
                                        Margin="0,10,8,10"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border Background="{StaticResource Brush.Danger}"
                                                CornerRadius="8" Padding="4,0" MinWidth="16"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="10,-6,-6,0">
                                            <TextBlock Text="{Binding ReminderCount}"
                                                       Foreground="White" FontSize="10"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Button>

                                <ComboBox Width="128" Height="32"
                                          Style="{StaticResource ModernComboBox}"
                                          SelectedValuePath="Tag"
                                          SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0">
                                    <ComboBoxItem Content="{loc:Loc ArmenianAM}" Tag="hy"/>
                                    <ComboBoxItem Content="{loc:Loc RussianRU}" Tag="ru"/>
                                    <ComboBoxItem Content="{loc:Loc EnglishEN}" Tag="en"/>
                                </ComboBox>

                                <Button Style="{StaticResource WindowCaptionButton}"
                                        ToolTip="{loc:Loc Minimize}"
                                        Click="BtnMinimize_Click">
                                    <Path Data="M 0,5 H 12"
                                          Width="12" Height="10" Stretch="None"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Button>
                                <Button x:Name="BtnMaximize"
                                        Style="{StaticResource WindowCaptionButton}"
                                        Click="BtnMaximize_Click">
                                    <Grid Width="12" Height="12">
                                        <Path x:Name="MaximizeIcon"
                                              Data="M 1,1 H 11 V 11 H 1 Z"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5"
                                              Fill="Transparent"/>
                                        <Path x:Name="RestoreIcon"
                                              Data="M 3.5,1 H 11 V 8.5 M 1,3.5 H 8.5 V 11 H 1 Z"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5"
                                              Fill="Transparent"
                                              Visibility="Collapsed"/>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource WindowCloseCaptionButton}"
                                        ToolTip="{loc:Loc Close}"
                                        Click="BtnExit_Click">
                                    <Path Data="M 1,1 L 11,11 M 11,1 L 1,11"
                                          Width="12" Height="12"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource Brush.AppBackground}" Padding="20">
                        <ContentControl Content="{Binding CurrentViewModel}"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"/>
                    </Border>
                </Grid>
            </Grid>

            <Grid Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVis}}"
                  Panel.ZIndex="20">
                <Border Background="{StaticResource Brush.DialogOverlay}"/>
                <ContentControl Content="{Binding DialogContent}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Margin="24"/>
            </Grid>
        </Grid>
    </Border>
</Window>

<Window x:Class="MyOrganizer.Wpf.MVVM.UI.ToothWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MyOrganizer.Wpf.Localization"
        xmlns:chart="clr-namespace:MyOrganizer.Wpf.MVVM.Views.DentalChart"
        Title="{loc:Loc ToothChart}"
        Height="760" Width="1320"
        MinHeight="560" MinWidth="960"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Border CornerRadius="16"
            Background="{StaticResource Brush.AppBackground}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource Brush.Primary}" CornerRadius="16,16,0,0">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc ToothChart}"
                                   Foreground="White" FontSize="18" FontWeight="SemiBold"
                                   FontFamily="Segoe UI"/>
                        <TextBlock x:Name="TxtClientName" Margin="16,0,0,0"
                                   Foreground="#D6E6F5" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Width="40" Height="40"
                            Background="Transparent" BorderBrush="{x:Null}"
                            Click="pictureBox2_Click">
                        <TextBlock Text="✕" Foreground="White" FontSize="18"/>
                    </Button>
                </Grid>
            </Border>

            <chart:DentalChartView x:Name="PartChart" Grid.Row="1" Margin="16,12,16,16"/>
        </Grid>
    </Border>
</Window>
